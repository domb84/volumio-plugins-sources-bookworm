[Unit]
Description=retrotuner-ui
# pigpiod is required for the rotary encoder. index.js starts it before this
# service, but a bare `systemctl start retrotuner-ui` would otherwise race it.
After=volumio.service pigpiod.service
Wants=pigpiod.service
# Without a limit, a config error that exits non-zero restart-loops forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=volumio
Group=volumio
WorkingDirectory=/data/plugins/user_interface/retrotuner-ui/
ExecStart=/data/retrotuner-ui/venv/bin/python3 /data/plugins/user_interface/retrotuner-ui/index.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
