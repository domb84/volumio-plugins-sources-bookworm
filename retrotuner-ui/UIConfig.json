{
  "page": {
    "label": "RetroTuner UI Configuration"
  },
  "sections": [
    {
      "id": "buttons",
      "element": "section",
      "label": "Button ADC Pin Configuration",
      "icon": "fa-cogs",
      "description": "Pin configuration to read button presses from an MCP3008 ADC. Switching between SPI and bitbang mode requires a full device reboot to take effect (not just a plugin restart).",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/retrotuner-ui",
        "method": "saveOptions"
      },
      "saveButton": {
        "label": "Save",
        "data": [
          "spi",
          "spi_bus",
          "buttons_clk",
          "buttons_miso",
          "buttons_mosi",
          "buttons_cs",
          "buttons_channel1",
          "buttons_channel2"
        ]
      },
      "content": [
        {
          "id": "spi",
          "element": "switch",
          "label": "SPI mode",
          "value": false
        },
        {
          "id": "spi_bus",
          "type": "number",
          "element": "input",
          "label": "SPI bus (0 or 1)",
          "value": ""
        },
        {
          "id": "buttons_clk",
          "type": "number",
          "element": "input",
          "label": "Buttons CLK pin",
          "value": ""
        },
        {
          "id": "buttons_miso",
          "type": "number",
          "element": "input",
          "label": "Buttons MISO pin",
          "value": ""
        },
        {
          "id": "buttons_mosi",
          "type": "number",
          "element": "input",
          "label": "Buttons MOSI pin",
          "value": ""
        },
        {
          "id": "buttons_cs",
          "type": "number",
          "element": "input",
          "label": "Buttons CS pin",
          "value": ""
        },
        {
          "id": "buttons_channel1",
          "type": "number",
          "element": "input",
          "label": "Buttons Channel 1 (MCP3008) pin",
          "value": ""
        },
        {
          "id": "buttons_channel2",
          "type": "number",
          "element": "input",
          "label": "Buttons Channel 2 (MCP3008) pin",
          "value": ""
        }
      ]
    },
    {
      "id": "button_capture",
      "element": "section",
      "label": "Configure Buttons",
      "icon": "fa-magic",
      "description": "Each button below shows its current value. To set one: click 'Configure', then press that physical button on the unit twice to confirm. To unmap a button: click its 'Configure', then click 'Clear Selected Button'. If you set a button to a value already used by another, the other is reassigned automatically. Use 'Capture Base Resistance' to record the resting value while pressing nothing. Make all your changes, then click 'Save & Restart Controls' to apply them at once.",
      "content": [
        {
          "id": "capture_btn_enter",
          "element": "button",
          "label": "Configure Enter",
          "onClick": {
            "type": "controller",
            "endpoint": "user_interface/retrotuner-ui",
            "method": "captureBtnEnter",
            "data": []
          }
        },
        {
          "id": "capture_btn_radio",
