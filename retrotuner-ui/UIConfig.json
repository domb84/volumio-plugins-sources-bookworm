    {
      "id": "encoder",
      "element": "section",
      "label": "Rotary Encoder Pin Configuration",
      "icon": "fa-cogs",
      "description": "Pin configuration for your rotary encoder for menu navigation.",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/retrotuner-ui",
        "method": "saveOptions"
      },
      "saveButton": {
        "label": "Save",
        "data": [
          "rot_enc_A",
          "rot_enc_B",
          "rotary_skip_track"
        ]
      },
      "content": [
        {
          "id": "rot_enc_A",
          "type": "number",
          "element": "input",
          "label": "Rotary encoder pin A",
          "value": ""
        },
        {
          "id": "rot_enc_B",
          "type": "number",
          "element": "input",
          "label": "Rotary encoder pin B",
          "value": ""
        },
        {
          "id": "rotary_skip_track",
          "element": "switch",
          "label": "Rotary encoder skips tracks when not navigating a menu (off = always scrolls the menu)",
          "description": "Off by default: on some encoders, electrical noise can register as a turn even when nobody touches it. That's harmless when it only scrolls a menu, but can unexpectedly skip or stop playback if enabled.",
          "value": false
        }
      ]
    },
