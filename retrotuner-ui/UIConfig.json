    {
      "id": "level_meter",
      "element": "section",
      "label": "Audio Level Meter",
      "icon": "fa-signal",
      "description": "The spectrum display, shown by long-pressing the dimmer and after 30 seconds idle while something is playing. Higher rates look smoother but cost CPU: 60 uses roughly 20% on a Pi 3B+, 120 around 40%. Drop to 15 if button presses start feeling sluggish. Layout: mono spends all 16 columns on the whole frequency range. Stereo mirrored splits them into two 8-band meters either side of the centre. The two stereo row layouts give each channel a full 16 bands on a row of its own - twice the detail across the spectrum, but only 4 height steps instead of 16, because the display has just 8 custom characters to share between them. Saving this restarts the analyser, which may briefly interrupt playback.",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/retrotuner-ui",
        "method": "saveOptions"
      },
      "saveButton": {
        "label": "Save",
        "data": [
          "meter_framerate",
          "meter_mode"
        ]
      },
      "content": [
        {
          "id": "meter_framerate",
          "element": "select",
          "label": "Refresh rate",
          "value": {
            "value": 60,
            "label": "60 fps"
          },
          "options": [
            {
              "value": 15,
              "label": "15 fps"
            },
            {
              "value": 30,
              "label": "30 fps"
            },
            {
              "value": 60,
              "label": "60 fps"
            },
            {
              "value": 120,
              "label": "120 fps"
            }
          ]
        },
        {
          "id": "meter_mode",
          "element": "select",
          "label": "Layout",
          "value": {
            "value": "mono",
            "label": "Mono - 16 bands, full height"
          },
          "options": [
            {
              "value": "mono",
              "label": "Mono - 16 bands, full height"
            },
            {
              "value": "stereo",
              "label": "Stereo mirrored - 8 bands per channel"
            },
            {
              "value": "rows_edges",
              "label": "Stereo rows - grow in from the edges"
            },
            {
              "value": "rows_centre",
              "label": "Stereo rows - grow out from the centre"
            },
            {
              "value": "vu",
              "label": "VU meters - one level bar per channel, with peak hold"
            }
          ]
        }
      ]
    },
    {
      "id": "screen_effects",
      "element": "section",
      "label": "Screen Effects",
      "icon": "fa-magic",
      "description": "A graphic while the plugin starts, and an idle screen for when nothing is playing. The level meter already covers the idle case while something plays, so the screensaver only appears once playback has stopped and the countdown below has run out. Any button press dismisses it. Leave the text boxes empty to use the device name; only the first 16 characters fit. Of the screensavers only bouncing text uses it - the rest draw a graphic and ignore it.",
      "onSave": {
        "type": "controller",
        "endpoint": "user_interface/retrotuner-ui",
        "method": "saveOptions"
      },
      "saveButton": {
        "label": "Save",
        "data": [
          "boot_effect",
          "boot_line1",
          "boot_line2",
          "screensaver_effect",
          "screensaver_line1",
          "screensaver_timeout"
        ]
      },
      "content": [
        {
          "id": "boot_effect",
          "element": "select",
          "label": "Boot graphic",
          "value": {
            "value": "splitflap",
            "label": "Split-flap - characters roll and settle"
          },
          "options": [
            {
              "value": "none",
              "label": "None - straight to the menu"
            },
            {
              "value": "splitflap",
              "label": "Split-flap - characters roll and settle"
            },
            {
              "value": "post",
              "label": "Power-on self test - all segments, then dissolve"
            },
            {
              "value": "wipe",
              "label": "Wipe - a curtain sweeps across and back"
            },
            {
              "value": "typewriter",
              "label": "Typewriter - characters land one at a time"
            },
            {
              "value": "slide",
              "label": "Slide-in - the rows arrive, hold, then leave again"
            },
            {
              "value": "tease",
              "label": "Meter tease - bars rise, collapse, reveal the text"
            },
            {
              "value": "centre",
              "label": "Centre-out reveal - curtains part from the middle"
            }
          ]
        },
        {
          "id": "boot_line1",
          "type": "text",
          "element": "input",
          "label": "Boot text, line 1",
          "value": ""
        },
        {
          "id": "boot_line2",
